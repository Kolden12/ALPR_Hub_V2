<Window x:Class="SabreMDT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sabre ALPR Hub - Golden Master" Height="850" Width="1400"
        Background="#0A0A0A">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="15">
            <DockPanel>
                <TextBlock Text="SABRE HUB V2" Foreground="#00FF00" FontSize="22" FontWeight="Black"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="END SHIFT" Background="#FF3B30" Foreground="White" Padding="15,5" Command="{Binding EndShiftCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video Grid -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="5">
            <!-- Streams defined in previous phases -->
        </UniformGrid>

        <!-- Health HUD -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="HARDWARE STATUS:" Foreground="#AAA" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="BATTERY: " Foreground="White"/>
                    <TextBlock Text="{Binding BatteryVoltage, StringFormat={}{0:F1}V}"
                               Foreground="{Binding BatteryColor}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="TEMP: " Foreground="White"/>
                    <TextBlock Text="{Binding JetsonTemp, StringFormat={}{0:F0}°C}"
                               Foreground="{Binding TempColor}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GUARDIAN: " Foreground="White"/>
                    <TextBlock Text="{Binding GuardianStatus}"
                               Foreground="{Binding HeartbeatColor}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
