<Window x:Class="SabreMDT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sabre ALPR Hub - MDT Tactical" Height="800" Width="1400"
        Background="#0A0A0A">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Background="#1A1A1A" Padding="15">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SABRE HUB" Foreground="#00FF00" FontSize="22" FontWeight="Black"/>
                    <Border Background="#333" CornerRadius="4" Margin="15,0" Padding="8,2">
                        <TextBlock Text="CONNECTED" Foreground="#00FF00" FontSize="12" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="END SHIFT &amp; GENERATE REPORT" Background="#FF3B30" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="10,0" Command="{Binding EndShiftCommand}"/>
                    <TextBlock Text="OFFLOADING DATA..." Foreground="#FFCC00" VerticalAlignment="Center" Visibility="{Binding IsOffloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ProgressBar Width="150" Height="10" Margin="10,0" Value="75" Foreground="#00FF00" Visibility="{Binding IsOffloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2x2 Stream Grid -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="5">
            <Border BorderBrush="#222" BorderThickness="2" Margin="3">
                <Grid>
                    <Image x:Name="Stream1" Stretch="UniformToFill"/>
                    <TextBlock Text="CAM 1 - IR" Foreground="White" Background="#80000000" Padding="5" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <Border BorderBrush="#222" BorderThickness="2" Margin="3">
                <Grid>
                    <Image x:Name="Stream2" Stretch="UniformToFill"/>
                    <TextBlock Text="CAM 1 - COLOR" Foreground="White" Background="#80000000" Padding="5" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <Border BorderBrush="#222" BorderThickness="2" Margin="3">
                <Grid>
                    <Image x:Name="Stream3" Stretch="UniformToFill"/>
                    <TextBlock Text="CAM 2 - IR" Foreground="White" Background="#80000000" Padding="5" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <Border BorderBrush="#222" BorderThickness="2" Margin="3">
                <Grid>
                    <Image x:Name="Stream4" Stretch="UniformToFill"/>
                    <TextBlock Text="CAM 2 - COLOR" Foreground="White" Background="#80000000" Padding="5" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Hit Alert Overlay / Card -->
        <Border Grid.Row="1" Background="#E61A1A1A" Width="400" HorizontalAlignment="Right" Margin="20" CornerRadius="10"
                BorderBrush="#00FF00" BorderThickness="2" Visibility="{Binding ShowHitAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Padding="20">
                <TextBlock Text="HOTLIST MATCH" Foreground="Red" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <Image x:Name="HitCrop" Height="150" Stretch="Uniform" Margin="0,0,0,15"/>
                <TextBlock Text="{Binding LastPlate}" Foreground="White" FontSize="48" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LastYMMV}" Foreground="#00FF00" FontSize="18" HorizontalAlignment="Center" Margin="0,10"/>
                <Separator Background="#333" Margin="0,15"/>
                <TextBlock Text="{Binding LastGPS}" Foreground="#AAA" FontSize="14" HorizontalAlignment="Center"/>
                <Button Content="VIEW ON MAP" Background="#00FF00" Foreground="Black" FontWeight="Bold" Padding="10" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
