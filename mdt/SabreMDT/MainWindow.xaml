<Window x:Class="SabreMDT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sabre ALPR Hub - MDT Terminal" Height="720" Width="1280"
        Background="#121212">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1F1F1F" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="SABRE PATROL" Foreground="#00FF00" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text=" | SYSTEM ACTIVE" Foreground="White" FontSize="20" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Video Grid -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="5">
            <Border BorderBrush="#333" BorderThickness="1" Margin="2">
                <Grid>
                    <TextBlock Text="CAM 01 - IR" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"/>
                    <Image x:Name="Stream1" Stretch="Uniform"/>
                </Grid>
            </Border>
            <Border BorderBrush="#333" BorderThickness="1" Margin="2">
                <Grid>
                    <TextBlock Text="CAM 02 - IR" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"/>
                    <Image x:Name="Stream2" Stretch="Uniform"/>
                </Grid>
            </Border>
            <Border BorderBrush="#333" BorderThickness="1" Margin="2">
                <Grid>
                    <TextBlock Text="CAM 03 - COLOR" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"/>
                    <Image x:Name="Stream3" Stretch="Uniform"/>
                </Grid>
            </Border>
            <Border BorderBrush="#333" BorderThickness="1" Margin="2">
                <Grid>
                    <TextBlock Text="CAM 04 - COLOR" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"/>
                    <Image x:Name="Stream4" Stretch="Uniform"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Hit Panel -->
        <Border Grid.Row="2" Background="#1F1F1F" Margin="5" CornerRadius="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="LastHitCrop" Stretch="Uniform"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="LAST READ:" Foreground="#AAA" FontSize="12"/>
                    <TextBlock x:Name="PlateText" Text="ABC-1234" Foreground="White" FontSize="36" FontWeight="Bold"/>
                    <TextBlock x:Name="YMMVText" Text="2022 FORD EXPLORER - BLACK" Foreground="#00FF00" FontSize="18"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="LOCATION:" Foreground="#AAA" FontSize="12"/>
                    <TextBlock x:Name="GPSText" Text="29.4241, -98.4936" Foreground="White" FontSize="14"/>
                    <TextBlock x:Name="SpeedText" Text="72 KPH / NORTH" Foreground="White" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
