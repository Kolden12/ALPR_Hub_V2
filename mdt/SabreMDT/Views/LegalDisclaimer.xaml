<UserControl x:Class="SabreMDT.Views.LegalDisclaimer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0A0A">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
            <TextBlock Text="MANDATORY LEGAL DISCLAIMER" Foreground="Red" FontSize="28" FontWeight="Black" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <Border Background="#1A1A1A" Padding="20" CornerRadius="10">
                <TextBlock Text="This system is for authorized law enforcement use only. All data collected, including license plate reads, GPS locations, and images, are subject to legal audit and chain-of-custody protocols. By clicking 'Accept', you certify that you are the officer identified below and that this session is for official business."
                           Foreground="White" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
            </Border>

            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="Enter Officer ID to Sign:" Foreground="#AAA" Margin="0,0,0,5"/>
                <TextBox x:Name="OfficerIdInput" Text="{Binding OfficerId, UpdateSourceTrigger=PropertyChanged}"
                         Background="#222" Foreground="White" BorderBrush="#444" Padding="10" FontSize="18"/>
            </StackPanel>

            <Button Content="ACCEPT &amp; START SHIFT"
                    IsEnabled="{Binding IsOfficerIdValid}"
                    Command="{Binding AcceptDisclaimerCommand}"
                    Background="#00FF00" Foreground="Black" FontWeight="Bold" Padding="20,15" Margin="0,30,0,0" FontSize="16"/>
        </StackPanel>
    </Grid>
</UserControl>
